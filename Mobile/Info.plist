<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The audio session keeps the voice loop running with the screen locked on a walk. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<!-- The Mac is reached at its Tailscale address over ws://; Tailscale's WireGuard tunnel
	     encrypts it, and the app talks to nothing but the paired Mac. -->
	<!-- The pairing code is a dante-companion:// link, so the Camera app opens Dante with it. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>dev.dante.companion.pair</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>dante-companion</string>
			</array>
		</dict>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
</dict>
</plist>
